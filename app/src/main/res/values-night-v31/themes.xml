<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: same as values-night/themes.xml plus the branding image (drawable-night-xxhdpi/splash_branding.png,
         generated by scratchpad/make_branding.py: "piyo" + tagline in the theme's ink colours). -->
    <style name="Theme.Piyo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E1012</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Piyo</item>
    </style>
</resources>
