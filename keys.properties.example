# Copy to app/keys.properties (git-ignored). One build reads these for every environment.
# Emulator: 10.0.2.2 is the PC's localhost. Phone on the same Wi-Fi: http://<PC-IPv4> (Caddy on port 80).
PIYO_API_BASE_URL=http://10.0.2.2:8080
# Empty (recommended) = the city map bundled in the app: offline, light + dark with the same layers
# (assets/map, docs/implementation/MAP_HOSTING.md §0). Overrides:
# MAP_STYLE_URL=http://<api>/v1/map/style.json                   (Docker stack style; Cloud Run does not serve it)
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty     (hosted; also bright, positron)
# MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark   (dark twin of a hosted style; fewer points)
# Any key can also be passed to one build: ./gradlew assembleRelease -PMAP_STYLE_URL=
MAP_STYLE_URL=
MAP_STYLE_DARK_URL=
GEOCODER_URL=https://photon.komoot.io/api/
# Push notifications (FCM, docs/implementation/PRIVACY.md §Push). Empty = push off, the app works the same.
# Firebase console → Project settings → General → Your apps (Android app bo.piyo.app):
# App ID (1:123…:android:abc…), Web API key, Project ID, Project number. No google-services.json needed.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
# GOOGLE_MAPS_API_KEY=   (unused until a GoogleMapProvider is added; see docs/implementation/MAP_PROVIDERS.md)
